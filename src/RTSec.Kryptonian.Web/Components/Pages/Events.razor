@page "/events"
@inject IKryptonianApiClient ApiClient
@inject ISnackbar Snackbar
@implements IAsyncDisposable


<PageTitle>Enrollment Events - Kryptonian Admin</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Enrollment Events</MudText>

@* ============================================================
   Top half: live gateway activity (polls /api/status/logs/recent)
   ============================================================ *@
<MudPaper Class="pa-3 mb-4" Elevation="2">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.Bolt" Color="@(_streaming ? Color.Success : Color.Default)" />
            <MudText Typo="Typo.h6">Live Gateway Activity</MudText>
            @if (_streaming)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">Streaming</MudChip>
            }
            else
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">Paused</MudChip>
            }
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                @_logEntries.Count entries @(_lastPollAt.HasValue ? $" • updated {(_lastPollAt.Value).ToString("HH:mm:ss")}" : "")
            </MudText>
        </MudStack>
        <MudStack Row="true" Spacing="1">
            <MudSelect T="string" @bind-Value="_levelFilter" Dense="true" Style="min-width: 120px;" Label="Min level">
                <MudSelectItem Value="@("Verbose")">Verbose</MudSelectItem>
                <MudSelectItem Value="@("Debug")">Debug</MudSelectItem>
                <MudSelectItem Value="@("Information")">Information</MudSelectItem>
                <MudSelectItem Value="@("Warning")">Warning</MudSelectItem>
                <MudSelectItem Value="@("Error")">Error</MudSelectItem>
                <MudSelectItem Value="@("Fatal")">Fatal</MudSelectItem>
            </MudSelect>
            <MudTooltip Text="@(_streaming ? "Pause polling" : "Resume polling")">
                <MudIconButton Icon="@(_streaming ? Icons.Material.Filled.Pause : Icons.Material.Filled.PlayArrow)"
                               Color="Color.Primary"
                               OnClick="@TogglePolling" />
            </MudTooltip>
            <MudTooltip Text="Clear log panel">
                <MudIconButton Icon="@Icons.Material.Filled.ClearAll" OnClick="@ClearLog" />
            </MudTooltip>
        </MudStack>
    </MudStack>

    <div style="height: 360px; overflow-y: auto; background: #0f1419; color: #e8e8e8;
                font-family: 'Cascadia Mono', 'Consolas', 'Menlo', monospace; font-size: 12.5px;
                border-radius: 4px; padding: 8px;">
        @if (!_logEntries.Any())
        {
            <div style="color: #888; padding: 8px;">Waiting for gateway activity…</div>
        }
        else
        {
            @foreach (var entry in FilteredLogEntries)
            {
                <div style="white-space: pre-wrap; line-height: 1.45; padding: 2px 4px; border-bottom: 1px solid #1c232b;">
                    <span style="color: #6c7680;">@entry.Timestamp.ToLocalTime().ToString("HH:mm:ss.fff")</span>
                    <span style="color: @LevelColor(entry.Level); font-weight: 600; margin-left: 8px; display: inline-block; width: 38px;">@LevelAbbrev(entry.Level)</span>
                    @if (!string.IsNullOrEmpty(entry.CorrelationId))
                    {
                        <span style="color: #5a8c9b; margin-left: 4px;">[@entry.CorrelationId]</span>
                    }
                    @if (!string.IsNullOrEmpty(entry.ClientIp) && entry.ClientIp != "::1")
                    {
                        <span style="color: #8c7a5a; margin-left: 4px;">@entry.ClientIp</span>
                    }
                    <span style="margin-left: 6px;">@entry.Message</span>
                    @if (!string.IsNullOrEmpty(entry.Exception))
                    {
                        <div style="color: #d96e6e; margin-left: 56px; white-space: pre-wrap;">@entry.Exception</div>
                    }
                </div>
            }
        }
    </div>
</MudPaper>

@* ============================================================
   Bottom half: filtered enrollment-events table (existing UX)
   ============================================================ *@
<MudPaper Class="pa-4 mb-4" Elevation="2">
    <MudStack Row="true" AlignItems="AlignItems.End" Spacing="4">
        <MudSelect @bind-Value="_selectedProfileId"
                   Label="Filter by Profile"
                   Clearable="true"
                   Style="min-width: 250px;">
            @foreach (var profile in _profiles)
            {
                <MudSelectItem Value="@profile.Id">@profile.Name</MudSelectItem>
            }
        </MudSelect>

        <MudSelect @bind-Value="_selectedStatus"
                   Label="Filter by Status"
                   Clearable="true"
                   Style="min-width: 150px;">
            <MudSelectItem Value="@("issued")">Issued</MudSelectItem>
            <MudSelectItem Value="@("pending")">Pending</MudSelectItem>
            <MudSelectItem Value="@("rejected")">Rejected</MudSelectItem>
            <MudSelectItem Value="@("error")">Error</MudSelectItem>
        </MudSelect>

        <MudNumericField @bind-Value="_limit"
                         Label="Limit"
                         Min="10"
                         Max="500"
                         Style="max-width: 100px;" />

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Search"
                   OnClick="@LoadEventsAsync">
            Search
        </MudButton>

        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   OnClick="@ResetFilters">
            Reset
        </MudButton>
    </MudStack>
</MudPaper>

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else if (!_events.Any())
{
    <MudAlert Severity="Severity.Info">
        No enrollment events found matching the selected filters.
    </MudAlert>
}
else
{
    <MudPaper Elevation="2">
        <MudTable Items="@FilteredEvents" Hover="true" Dense="true">
            <HeaderContent>
                <MudTh>
                    <MudTableSortLabel SortBy="new Func<EnrollmentEventDto, object>(x => x.Timestamp)">Time</MudTableSortLabel>
                </MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Profile</MudTh>
                <MudTh>Subject DN</MudTh>
                <MudTh>Device ID</MudTh>
                <MudTh>IP Address</MudTh>
                <MudTh>Details</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Time">
                    <MudTooltip Text="@context.Timestamp.ToString("O")">
                        @context.Timestamp.ToString("g")
                    </MudTooltip>
                </MudTd>
                <MudTd DataLabel="Status">
                    <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.Status)">@context.Status</MudChip>
                </MudTd>
                <MudTd DataLabel="Profile">
                    @{
                        var profile = _profiles.FirstOrDefault(p => p.Id == context.ProfileId);
                    }
                    @(profile?.Name ?? context.ProfileId)
                </MudTd>
                <MudTd DataLabel="Subject DN">
                    @if (!string.IsNullOrEmpty(context.SubjectDn))
                    {
                        <MudTooltip Text="@context.SubjectDn">
                            <span class="d-inline-block text-truncate" style="max-width: 200px;">@context.SubjectDn</span>
                        </MudTooltip>
                    }
                    else
                    {
                        <span>-</span>
                    }
                </MudTd>
                <MudTd DataLabel="Device ID">@(context.DeviceId ?? "-")</MudTd>
                <MudTd DataLabel="IP Address">@(context.RequestorIpAddress ?? "-")</MudTd>
                <MudTd DataLabel="Details">
                    @if (!string.IsNullOrEmpty(context.ErrorMessage))
                    {
                        <MudTooltip Text="@context.ErrorMessage">
                            <MudIconButton Icon="@Icons.Material.Filled.Error" Color="Color.Error" Size="Size.Small" />
                        </MudTooltip>
                    }
                    else if (!string.IsNullOrEmpty(context.IssuedCertificateId))
                    {
                        <MudTooltip Text="Certificate issued">
                            <MudIconButton Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                        </MudTooltip>
                    }
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager PageSizeOptions="new int[] { 25, 50, 100 }" />
            </PagerContent>
        </MudTable>
    </MudPaper>

    <MudText Typo="Typo.caption" Class="mt-2" Color="Color.Secondary">
        Showing @FilteredEvents.Count() of @_events.Count events
    </MudText>
}

@code {
    private bool _loading = true;
    private List<EnrollmentEventDto> _events = new();
    private List<EstProfileDto> _profiles = new();

    private string? _selectedProfileId;
    private string? _selectedStatus;
    private int _limit = 100;

    // --- Live-log panel state ---
    private readonly List<LiveLogEntryDto> _logEntries = new();
    private const int LogPanelCapacity = 500;
    private long _lastSeenSeq = 0;
    private bool _streaming = true;
    private string _levelFilter = "Information";
    private DateTime? _lastPollAt;
    private CancellationTokenSource? _pollCts;
    private Task? _pollLoop;

    private static readonly TimeSpan PollInterval = TimeSpan.FromMilliseconds(1500);

    private static readonly Dictionary<string, int> LevelRank = new(StringComparer.OrdinalIgnoreCase)
    {
        ["Verbose"] = 0,
        ["Debug"] = 1,
        ["Information"] = 2,
        ["Warning"] = 3,
        ["Error"] = 4,
        ["Fatal"] = 5,
    };

    private IEnumerable<EnrollmentEventDto> FilteredEvents =>
        _events.Where(e =>
            (string.IsNullOrEmpty(_selectedStatus) || e.Status == _selectedStatus));

    private IEnumerable<LiveLogEntryDto> FilteredLogEntries
    {
        get
        {
            var threshold = LevelRank.TryGetValue(_levelFilter, out var r) ? r : 2;
            return _logEntries.Where(e =>
                LevelRank.TryGetValue(e.Level, out var er) ? er >= threshold : true);
        }
    }

    protected override void OnInitialized()
    {
        ApiClient.OnApiError += HandleApiError;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadInitialDataAsync();
        StartPolling();
    }

    private void HandleApiError(object? sender, ApiErrorEventArgs e)
    {
        InvokeAsync(() =>
        {
            var severity = e.ErrorType switch
            {
                ApiErrorType.Unauthorized => Severity.Warning,
                ApiErrorType.Forbidden => Severity.Warning,
                ApiErrorType.ServerError => Severity.Error,
                _ => Severity.Error
            };
            Snackbar.Add(e.Message, severity);
            StateHasChanged();
        });
    }

    private async Task LoadInitialDataAsync()
    {
        _loading = true;
        try
        {
            var profilesTask = ApiClient.GetEstProfilesAsync();
            var eventsTask = ApiClient.GetEnrollmentEventsAsync(limit: _limit);
            await Task.WhenAll(profilesTask, eventsTask);

            var profilesResult = await profilesTask;
            var eventsResult = await eventsTask;

            _profiles = profilesResult.Success && profilesResult.Data != null
                ? profilesResult.Data.ToList()
                : new List<EstProfileDto>();
            _events = eventsResult.Success && eventsResult.Data != null
                ? eventsResult.Data.ToList()
                : new List<EnrollmentEventDto>();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadEventsAsync()
    {
        _loading = true;
        try
        {
            var result = await ApiClient.GetEnrollmentEventsAsync(
                profileId: _selectedProfileId,
                limit: _limit);

            _events = result.Success && result.Data != null
                ? result.Data.ToList()
                : new List<EnrollmentEventDto>();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ResetFilters()
    {
        _selectedProfileId = null;
        _selectedStatus = null;
        _limit = 100;
        await LoadEventsAsync();
    }

    private static Color GetStatusColor(string status) => status.ToLowerInvariant() switch
    {
        "issued" => Color.Success,
        "pending" => Color.Warning,
        "rejected" => Color.Error,
        "error" => Color.Error,
        _ => Color.Default
    };

    // ---- Live-log polling ----

    private void StartPolling()
    {
        if (_pollLoop != null) return;
        _pollCts = new CancellationTokenSource();
        _pollLoop = Task.Run(() => PollLoopAsync(_pollCts.Token));
    }

    private async Task PollLoopAsync(CancellationToken ct)
    {
        while (!ct.IsCancellationRequested)
        {
            try
            {
                if (_streaming)
                {
                    var result = await ApiClient.GetRecentLogsAsync(_lastSeenSeq, 500, ct);
                    if (result.Success && result.Data != null)
                    {
                        await InvokeAsync(() => MergeLogEntries(result.Data));
                    }
                }
            }
            catch (OperationCanceledException)
            {
                break;
            }
            catch
            {
                // Swallow transient errors; the API client already surfaces them via OnApiError.
            }

            try
            {
                await Task.Delay(PollInterval, ct);
            }
            catch (OperationCanceledException)
            {
                break;
            }
        }
    }

    private void MergeLogEntries(LiveLogPageDto page)
    {
        if (page.Entries.Count > 0)
        {
            // Newest at top: insert in reverse-seq order at index 0.
            foreach (var entry in page.Entries.OrderBy(e => e.Seq))
            {
                _logEntries.Insert(0, entry);
                if (entry.Seq > _lastSeenSeq) _lastSeenSeq = entry.Seq;
            }
            if (_logEntries.Count > LogPanelCapacity)
            {
                _logEntries.RemoveRange(LogPanelCapacity, _logEntries.Count - LogPanelCapacity);
            }
        }
        else if (page.CurrentSeq > _lastSeenSeq)
        {
            // No matching entries returned (e.g. ring buffer rolled past us) — fast-forward
            // so we don't keep re-requesting the same lost window.
            _lastSeenSeq = page.CurrentSeq;
        }

        _lastPollAt = DateTime.Now;
        StateHasChanged();
    }

    private void TogglePolling()
    {
        _streaming = !_streaming;
    }

    private void ClearLog()
    {
        _logEntries.Clear();
    }

    private static string LevelAbbrev(string level) => level switch
    {
        "Verbose" => "VRB",
        "Debug" => "DBG",
        "Information" => "INF",
        "Warning" => "WRN",
        "Error" => "ERR",
        "Fatal" => "FTL",
        _ => level
    };

    private static string LevelColor(string level) => level switch
    {
        "Verbose" => "#7a8590",
        "Debug" => "#8aa9c9",
        "Information" => "#7ec97e",
        "Warning" => "#e8c468",
        "Error" => "#e87575",
        "Fatal" => "#ff5577",
        _ => "#cccccc"
    };

    public async ValueTask DisposeAsync()
    {
        ApiClient.OnApiError -= HandleApiError;
        try
        {
            _pollCts?.Cancel();
            if (_pollLoop != null)
            {
                await _pollLoop;
            }
        }
        catch
        {
            // ignore
        }
        finally
        {
            _pollCts?.Dispose();
            _pollCts = null;
            _pollLoop = null;
        }
    }
}
