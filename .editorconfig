# RTSec.Kryptonian Medical/Healthcare .NET Standards
# Strict quality requirements for patient safety and regulatory compliance

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# C# files
[*.cs]
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true
csharp_new_line_between_query_expression_clauses = true

# Indentation
indent_style = space
indent_size = 4

# Spacing
csharp_space_after_cast = false
csharp_space_after_colon_in_inheritance_clause = true
csharp_space_after_comma = true
csharp_space_after_dot = false
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_before_colon_in_inheritance_clause = true
csharp_space_before_comma = false
csharp_space_before_dot = false
csharp_space_before_open_square_bracket = false
csharp_space_between_empty_square_brackets = false
csharp_space_within_square_brackets = false
csharp_space_between_empty_method_call_arguments = false
csharp_space_within_method_call_arguments = false
csharp_space_within_empty_method_declaration_parameter_list = false
csharp_space_within_method_declaration_parameter_list = false

# Wrapping
csharp_preserve_single_line_blocks = true
csharp_preserve_single_line_statements = true

# Code quality rules (strict for medical software)
dotnet_diagnostic.CA1001.severity = warning  # Types that own disposable fields should be disposable
dotnet_diagnostic.CA1062.severity = warning  # Validate arguments of public methods
dotnet_diagnostic.CA1303.severity = warning  # Do not pass literals as localized parameters
dotnet_diagnostic.CA1304.severity = warning  # Specify CultureInfo
dotnet_diagnostic.CA1305.severity = warning  # Specify IFormatProvider
dotnet_diagnostic.CA1307.severity = warning  # Specify StringComparison
dotnet_diagnostic.CA1309.severity = warning  # Use ordinal string comparison
dotnet_diagnostic.CA1401.severity = warning  # P/Invoke methods should not be visible
dotnet_diagnostic.CA1508.severity = warning  # Avoid dead conditional code
dotnet_diagnostic.CA1707.severity = warning  # Identifiers should not contain underscores
dotnet_diagnostic.CA1711.severity = warning  # Identifiers should not have incorrect suffix
dotnet_diagnostic.CA1724.severity = warning  # Type names should not match namespaces
dotnet_diagnostic.CA1725.severity = warning  # Use parameter names from base method
dotnet_diagnostic.CA1819.severity = warning  # Properties should not return arrays
dotnet_diagnostic.CA2000.severity = warning  # Dispose objects before losing scope
dotnet_diagnostic.CA2100.severity = warning  # Review SQL queries for security vulnerabilities
dotnet_diagnostic.CA2213.severity = warning  # Disposable fields should be disposed
dotnet_diagnostic.CA2219.severity = warning  # Do not raise exceptions in finally clauses
dotnet_diagnostic.CA2227.severity = warning  # Collection properties should be read-only
dotnet_diagnostic.CA2231.severity = warning  # Overload operator equals on overriding value type

# StyleCop rules (strict consistency)
dotnet_diagnostic.SA1101.severity = error  # Prefix local calls with this
dotnet_diagnostic.SA1200.severity = error  # Using directives must be placed correctly
dotnet_diagnostic.SA1201.severity = error  # Elements must appear in the correct order
dotnet_diagnostic.SA1202.severity = error  # All elements must be ordered by access
dotnet_diagnostic.SA1300.severity = error  # Element names must begin with upper-case letter
dotnet_diagnostic.SA1303.severity = error  # Const field names must begin with upper-case letter
dotnet_diagnostic.SA1304.severity = error  # Non-private readonly fields must begin with upper-case letter
dotnet_diagnostic.SA1306.severity = error  # Field names must begin with lower-case letter
dotnet_diagnostic.SA1307.severity = error  # Accessible fields must begin with upper-case letter
dotnet_diagnostic.SA1309.severity = error  # Field names must not begin with underscore
dotnet_diagnostic.SA1310.severity = error  # Field names must not contain underscore
dotnet_diagnostic.SA1401.severity = error  # Fields must be private
dotnet_diagnostic.SA1500.severity = error  # Braces for multi-line statements must not share line
dotnet_diagnostic.SA1501.severity = error  # Statement must not be on a single line
dotnet_diagnostic.SA1502.severity = error  # Element must not be on a single line
dotnet_diagnostic.SA1503.severity = error  # Braces must not be omitted
dotnet_diagnostic.SA1505.severity = error  # An opening brace must not be followed by a blank line
dotnet_diagnostic.SA1506.severity = error  # Element documentation must not be followed by blank line
dotnet_diagnostic.SA1507.severity = error  # Code must not contain multiple blank lines in a row
dotnet_diagnostic.SA1508.severity = error  # A closing brace must not be preceded by a blank line
dotnet_diagnostic.SA1509.severity = error  # Opening braces must not be preceded by blank line
dotnet_diagnostic.SA1510.severity = error  # Closing braces must not be preceded by blank line
dotnet_diagnostic.SA1512.severity = error  # Single-line comments must not be followed by blank line
dotnet_diagnostic.SA1513.severity = error  # Closing brace must be followed by blank line
dotnet_diagnostic.SA1515.severity = error  # Single-line comment must be preceded by blank line
dotnet_diagnostic.SA1516.severity = error  # Elements must be separated by blank line
dotnet_diagnostic.SA1517.severity = error  # Code must not contain blank lines at start of file
dotnet_diagnostic.SA1518.severity = error  # Code must not contain blank lines at end of file
dotnet_diagnostic.SA1600.severity = error  # Element must be documented
dotnet_diagnostic.SA1601.severity = error  # Partial elements must be documented
dotnet_diagnostic.SA1602.severity = error  # Enumeration items must be documented
dotnet_diagnostic.SA1604.severity = error  # Element documentation must have summary
dotnet_diagnostic.SA1605.severity = error  # Partial element documentation must have summary
dotnet_diagnostic.SA1606.severity = error  # Element documentation must have summary text
dotnet_diagnostic.SA1607.severity = error  # Element documentation must have summary text
dotnet_diagnostic.SA1608.severity = error  # Element documentation must not have default summary
dotnet_diagnostic.SA1609.severity = error  # Property documentation must have summary
dotnet_diagnostic.SA1610.severity = error  # Property documentation must have summary text
dotnet_diagnostic.SA1611.severity = error  # Parameter documentation must be provided
dotnet_diagnostic.SA1612.severity = error  # Parameter documentation must match element parameters
dotnet_diagnostic.SA1613.severity = error  # Parameter documentation must have text
dotnet_diagnostic.SA1614.severity = error  # Parameter documentation must not have empty summary
dotnet_diagnostic.SA1615.severity = error  # Element return value must be documented
dotnet_diagnostic.SA1616.severity = error  # Element return value must have text
dotnet_diagnostic.SA1617.severity = error  # Void return value must not be documented
dotnet_diagnostic.SA1618.severity = error  # Generic type parameters must be documented
dotnet_diagnostic.SA1619.severity = error  # Generic type parameters must be documented
dotnet_diagnostic.SA1620.severity = error  # Generic type parameter documentation must match type parameters
dotnet_diagnostic.SA1621.severity = error  # Generic type parameter documentation must have text
dotnet_diagnostic.SA1622.severity = error  # Generic type parameter documentation must have text
dotnet_diagnostic.SA1623.severity = error  # Property summary documentation must begin with: gets or sets
dotnet_diagnostic.SA1624.severity = error  # Property summary documentation must begin with: Gets or sets
dotnet_diagnostic.SA1625.severity = error  # Element documentation must not be copied
dotnet_diagnostic.SA1626.severity = error  # Single-line comment must not begin with text
dotnet_diagnostic.SA1627.severity = error  # Documentation text must not be empty
dotnet_diagnostic.SA1628.severity = error  # Documentation text must be on separate lines
dotnet_diagnostic.SA1629.severity = error  # Documentation text must end with a period
dotnet_diagnostic.SA1630.severity = error  # Documentation text must contain at least one paragraph
dotnet_diagnostic.SA1631.severity = error  # Documentation text must contain at least one paragraph
dotnet_diagnostic.SA1632.severity = error  # Documentation text must contain at least one paragraph
dotnet_diagnostic.SA1633.severity = error  # File must have header
dotnet_diagnostic.SA1634.severity = error  # File header must show copyright
dotnet_diagnostic.SA1635.severity = error  # File header must have copyright text
dotnet_diagnostic.SA1636.severity = error  # File header copyright text must match pattern
dotnet_diagnostic.SA1637.severity = error  # File header must contain copyright text
dotnet_diagnostic.SA1638.severity = error  # File header copyright text must include company name
dotnet_diagnostic.SA1639.severity = error  # File header must have summary
dotnet_diagnostic.SA1640.severity = error  # File header must have summary text
dotnet_diagnostic.SA1641.severity = error  # File header summary must be provided
dotnet_diagnostic.SA1642.severity = error  # Constructor summary documentation must begin with standard text
dotnet_diagnostic.SA1643.severity = error  # Destructor summary documentation must begin with standard text
dotnet_diagnostic.SA1644.severity = error  # Exception documentation must be included
dotnet_diagnostic.SA1645.severity = error  # Included documentation must exist
dotnet_diagnostic.SA1646.severity = error  # Included documentation must contain text
dotnet_diagnostic.SA1647.severity = error  # Include documentation must have file path
dotnet_diagnostic.SA1648.severity = error  # Include documentation must use correct syntax
dotnet_diagnostic.SA1649.severity = error  # File name must match first type name
dotnet_diagnostic.SA1650.severity = error  # Element documentation must be spelled correctly
dotnet_diagnostic.SA1651.severity = error  # Element documentation must not use invalid characters
dotnet_diagnostic.SA1652.severity = error  # Element documentation must not use invalid characters
dotnet_diagnostic.SA1653.severity = error  # Element documentation must not use invalid characters
dotnet_diagnostic.SA1654.severity = error  # Element documentation must not use invalid characters
